#!/usr/bin/env bash

from_commit=$(
	git log --oneline --decorate -100 --color=always |
		fzf \
			--ansi \
			--header '> difit <to_hash> <from_hash>~1' \
			--prompt 'Select from_hash>' \
			--preview 'git log --oneline --decorate --color=always -1 {1}' \
			--preview-window=top:3:wrap
) || exit
from_hash="${from_commit%% *}"

to_commit=$(
	git log --oneline --decorate -100 --color=always "$from_hash~1.." |
		fzf \
			--ansi \
			--header "> difit <to_hash> $from_hash~1" \
			--prompt 'Select to_hash>' \
			--preview 'git log --oneline --decorate --color=always -1 {1}' \
			--preview-window=top:3:wrap
) || exit
to_hash="${to_commit%% *}"

difit "$to_hash" "$from_hash~1"
